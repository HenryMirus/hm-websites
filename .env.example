# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── URLs ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PORTAL_URL=https://clients.hm-labs.de
NEXT_PUBLIC_OS_URL=https://os.hm-labs.de

# ── Agent OS dashboard (Phase 2) ───────────────────────────────────────────
# Fine-grained read-only GitHub token (repos, issues). Server-only — never NEXT_PUBLIC.
GITHUB_TOKEN=

# Vercel personal access token (read project + deployment list). Server-only.
VERCEL_TOKEN=

# ── Auth ───────────────────────────────────────────────────────────────────
RECOVERY_TOKEN_SECRET=

# ── Email / SMTP ───────────────────────────────────────────────────────────
NEXT_PUBLIC_EMAIL_CONTACT=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
WEBHOOK_SECRET=
# NOTIFY_VIA_WEBHOOK=true

# ── Tracking ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_GTM_ID=
