# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── URLs ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://hm-labs.tech
NEXT_PUBLIC_PORTAL_URL=https://clients.hm-labs.tech

# ── Agent OS dashboard (Phase 2) ───────────────────────────────────────────
# Fine-grained read-only GitHub token (repos, issues). Server-only — never NEXT_PUBLIC.
GITHUB_TOKEN=

# Vercel personal access token (read project + deployment list). Server-only.
VERCEL_TOKEN=

# ── Auth ───────────────────────────────────────────────────────────────────
RECOVERY_TOKEN_SECRET=

# ── Email / SMTP ───────────────────────────────────────────────────────────
NEXT_PUBLIC_EMAIL_CONTACT=info@hm-labs.tech
# Postfach für neue Website-Anfragen und Kunden-Nachrichten (leer = EMAIL_CONTACT)
EMAIL_INBOX=
# Hostinger: smtp.hostinger.com / 465, SMTP_USER = das Postfach selbst
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Absender, leer = "HM Labs <SMTP_USER>"
SMTP_FROM=
WEBHOOK_SECRET=
# NOTIFY_VIA_WEBHOOK=true

# ── Tracking ───────────────────────────────────────────────────────────────
# Produktivwerte für Umami und Clarity stehen in .env.production (im Repo, öffentlich).
# Nur zum lokalen Testen hier setzen:
# NEXT_PUBLIC_UMAMI_SRC=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Vorbereitet, aber nicht im Einsatz (müssten im Dockerfile als Build-ARG ergänzt
# oder in .env.production eingetragen werden):
# NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_GOOGLE_ADS_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
