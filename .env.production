# Öffentliche Tracking-Kennungen. Liegen bewusst im Repo: Sie stehen ohnehin im
# Browser-Code, sind keine Geheimnisse, und Next.js setzt sie beim Build ein.
# So braucht es keine Build-Args im Dockerfile und in der docker-compose.yml.
# Keine Geheimnisse hier eintragen. Leer = Dienst wird nicht geladen.
NEXT_PUBLIC_UMAMI_SRC=https://stats.hm-labs.de/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=405a2a12-c4c6-4b00-a277-cf96ac8316d9
